DATABASE_URL=postgresql://emdr:emdr@localhost:5434/emdr

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET=
APP_URL=http://localhost:3471

# Passkeys / WebAuthn (defaults from APP_URL hostname/origin)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3471

# Email — Brevo (primary)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EMDR Guide

# Email — Gmail API (fallback when Brevo quota is exceeded)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# Stripe (optional — billing checkout + webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Set to true when behind a trusted reverse proxy (nginx, Cloudflare, etc.)
TRUST_PROXY=

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
